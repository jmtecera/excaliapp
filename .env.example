SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer the modern server-only secret key. The legacy service-role key is also supported.
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVER_SIDE_SERVICE_ROLE_KEY

# Used only by `pnpm db:push`. Prefer the direct/non-pooling URL for migrations.
POSTGRES_URL_NON_POOLING=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
PORT=8787

# Optional. Leave blank on Vercel and in local development to use same-origin /api routes.
VITE_API_BASE_URL=
